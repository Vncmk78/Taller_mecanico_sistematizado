{
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "vite",
      "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
    },
    "backend": {
      "root": "backend",
      "framework": "fastapi",
      "entrypoint": "gateway/main:app",
      "bindings": [
        { "type": "service", "service": "ms-auth", "format": "url", "env": "GATEWAY_MS1_URL" },
        { "type": "service", "service": "ms-taller", "format": "url", "env": "GATEWAY_MS2_URL" },
        { "type": "service", "service": "ms-presupuestos", "format": "url", "env": "GATEWAY_MS3_URL" },
        { "type": "service", "service": "ms-evidencias", "format": "url", "env": "GATEWAY_MS4_URL" }
      ]
    },
    "ms-auth": {
      "root": "backend",
      "framework": "fastapi",
      "entrypoint": "services/ms1_auth/main:app",
      "routes": [
        { "src": "/ms1/(.*)", "transforms": [{ "type": "request.path", "op": "set", "args": "/$1" }] }
      ]
    },
    "ms-taller": {
      "root": "backend",
      "framework": "fastapi",
      "entrypoint": "services/ms2_taller/main:app",
      "routes": [
        { "src": "/ms2/(.*)", "transforms": [{ "type": "request.path", "op": "set", "args": "/$1" }] }
      ]
    },
    "ms-presupuestos": {
      "root": "backend",
      "framework": "fastapi",
      "entrypoint": "services/ms3_presupuestos/main:app",
      "routes": [
        { "src": "/ms3/(.*)", "transforms": [{ "type": "request.path", "op": "set", "args": "/$1" }] }
      ]
    },
    "ms-evidencias": {
      "root": "backend",
      "framework": "fastapi",
      "entrypoint": "services/ms4_evidencias/main:app",
      "routes": [
        { "src": "/ms4/(.*)", "transforms": [{ "type": "request.path", "op": "set", "args": "/$1" }] }
      ]
    }
  },
  "rewrites": [
    { "source": "/api(/.*)?", "destination": { "service": "backend" } },
    { "source": "/docs", "destination": { "service": "backend" } },
    { "source": "/openapi.json", "destination": { "service": "backend" } },
    { "source": "/redoc", "destination": { "service": "backend" } },
    { "source": "/ms1(/.*)?", "destination": { "service": "ms-auth" } },
    { "source": "/ms2(/.*)?", "destination": { "service": "ms-taller" } },
    { "source": "/ms3(/.*)?", "destination": { "service": "ms-presupuestos" } },
    { "source": "/ms4(/.*)?", "destination": { "service": "ms-evidencias" } },
    { "source": "/(.*)", "destination": { "service": "frontend" } }
  ]
}