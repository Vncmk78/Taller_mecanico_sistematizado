lAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#192C42;spacing=4;" parent="1" vertex="1"><mxGeometry as="geometry" x="1880" y="1266" width="470" height="64" /></mxCell><mxCell id="A9" value="Gestionar usuarios y roles" style="ellipse;shape=ellipse;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#6C8297;strokeWidth=1.6;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#192C42;spacing=4;" parent="1" vertex="1"><mxGeometry as="geometry" x="1880" y="1354" width="470" height="64" /></mxCell><mxCell id="A10" value="Configurar límites de capacidad" style="ellipse;shape=ellipse;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#6C8297;strokeWidth=1.6;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#192C42;spacing=4;" parent="1" vertex="1"><mxGeometry as="geometry" x="1880" y="1442" width="470" height="64" /></mxCell><mxCell id="A11" value="Configurar umbrales de stock" style="ellipse;shape=ellipse;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#6C8297;strokeWidth=1.6;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#192C42;spacing=4;" parent="1" vertex="1"><mxGeometry as="geometry" x="1880" y="1530" width="470" height="64" /></mxCell><mxCell id="A12" value="Gestionar repuestos, proveedores e inventario" style="ellipse;shape=ellipse;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#6C8297;strokeWidth=1.6;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#192C42;spacing=4;" parent="1" vertex="1"><mxGeometry as="geometry" x="1880" y="1618" width="470" height="64" /></mxCell><mxCell id="A13" value="Consultar panel de control" style="ellipse;shape=ellipse;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#6C8297;strokeWidth=1.6;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#192C42;spacing=4;" parent="1" vertex="1"><mxGeometry as="geometry" x="1880" y="1706" width="470" height="64" /></mxCell><mxCell id="ac_adm" value="Administrador" style="shape=umlActor;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#192C42;strokeWidth=2;verticalLabelPosition=bottom;verticalAlign=top;labelPosition=center;align=center;fontFamily=Arial;fontSize=18;fontStyle=1;fontColor=#192C42;" parent="1" vertex="1"><mxGeometry as="geometry" x="2528.0" y="1151.0" width="64" height="118" /></mxCell><mxCell id="e24" value="" style="edgeStyle=none;rounded=0;html=0;exitX=0.0;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1.0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;strokeColor=#6C8297;strokeWidth=1.6;endArrow=none;" parent="1" edge="1" source="ac_adm" target="A1"><mxGeometry as="geometry" relative="1"></mxGeometry></mxCell><mxCell id="e25" value="" style="edgeStyle=none;rounded=0;html=0;exitX=0.0;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1.0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;strokeColor=#6C8297;strokeWidth=1.6;endArrow=none;" parent="1" edge="1" source="ac_adm" target="A2"><mxGeometry as="geometry" relative="1"></mxGeometry></mxCell><mxCell id="e26" value="" style="edgeStyle=none;rounded=0;html=0;exitX=0.0;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1.0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;strokeColor=#6C8297;strokeWidth=1.6;endArrow=none;" parent="1" edge="1" source="ac_adm" target="A3"><mxGeometry as="geometry" relative="1"></mxGeometry></mxCell><mxCell id="e27" value="" style="edgeStyle=none;rounded=0;html=0;exitX=0.0;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1.0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;strokeColor=#6C8297;strokeWidth=1.6;endArrow=none;" parent="1" edge="1" source="ac_adm" target="A4"><mxGeometry as="geometry" relative="1"></mxGeometry></mxCell><mxCell id="e28" value="" style="edgeStyle=none;rounded=0;html=0;exitX=0.0;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1.0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;strokeColor=#6C8297;strokeWidth=1.6;endArrow=none;" parent="1" edge="1" source="ac_adm" target="A5"><mxGeometry as="geome