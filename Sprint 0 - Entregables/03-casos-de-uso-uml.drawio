" target="A11"><mxGeometry as="geometry" relative="1"></mxGeometry></mxCell><mxCell id="e35" value="" style="edgeStyle=none;rounded=0;html=0;exitX=0.0;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1.0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;strokeColor=#6C8297;strokeWidth=1.6;endArrow=none;" parent="1" edge="1" source="ac_adm" target="A12"><mxGeometry as="geometry" relative="1"></mxGeometry></mxCell><mxCell id="e36" value="" style="edgeStyle=none;rounded=0;html=0;exitX=0.0;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1.0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;strokeColor=#6C8297;strokeWidth=1.6;endArrow=none;" parent="1" edge="1" source="ac_adm" target="A13"><mxGeometry as="geometry" relative="1"></mxGeometry></mxCell><mxCell id="e37" value="" style="edgeStyle=none;rounded=0;html=0;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1.0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;strokeColor=#6C8297;strokeWidth=1.6;endArrow=none;" parent="1" edge="1" source="ac_adm" target="S1"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="2640" y="1210.0" /><mxPoint x="2640" y="2100" /><mxPoint x="840" y="2100" /><mxPoint x="840" y="2032" /></Array></mxGeometry></mxCell><mxCell id="IA1" value="Validar cupo diario" style="ellipse;shape=ellipse;whiteSpace=wrap;html=0;fillColor=#EAF2FC;strokeColor=#6C8297;strokeWidth=1.6;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#192C42;spacing=4;" parent="1" vertex="1"><mxGeometry as="geometry" x="1380" y="738" width="420" height="64" /></mxCell><mxCell id="e38" value="«include»" style="edgeStyle=none;rounded=0;html=0;exitX=0.0;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1.0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;strokeColor=#6C8297;strokeWidth=1.7;endArrow=open;endFill=0;dashed=1;dashPattern=6 4;verticalAlign=bottom;labelBackgroundColor=none;fontFamily=Arial;fontSize=15;fontColor=#526477;" parent="1" edge="1" source="A2" target="IA1"><mxGeometry as="geometry" relative="1"></mxGeometry></mxCell><mxCell id="IA2" value="Validar capacidad del mecánico" style="ellipse;shape=ellipse;whiteSpace=wrap;html=0;fillColor=#EAF2FC;strokeColor=#6C8297;strokeWidth=1.6;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#192C42;spacing=4;" parent="1" vertex="1"><mxGeometry as="geometry" x="1380" y="914" width="420" height="64" /></mxCell><mxCell id="e39" value="«include»" style="edgeStyle=none;rounded=0;html=0;exitX=0.0;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1.0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;strokeColor=#6C8297;strokeWidth=1.7;endArrow=open;endFill=0;dashed=1;dashPattern=6 4;verticalAlign=bottom;labelBackgroundColor=none;fontFamily=Arial;fontSize=15;fontColor=#526477;" parent="1" edge="1" source="A4" target="IA2"><mxGeometry as="geometry" relative="1"></mxGeometry></mxCell><mxCell id="IA3" value="Validar configuración de límites" style="ellipse;shape=ellipse;whiteSpace=wrap;html=0;fillColor=#EAF2FC;strokeColor=#6C8297;strokeWidth=1.6;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#192C42;spacing=4;" parent="1" vertex="1"><mxGeometry as="geometry" x="1380" y="1442" width="420" height="64" /></mxCell><mxCell id="e40" value="«include»" style="edgeStyle=none;rounded=0;html=0;exitX=0.0;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1.0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;strokeColor=#6C8297;strokeWidth=1.7;endArrow=open;endFill=0;dashed=1;dashPattern=6 4;verticalAlign=bottom;labelBackgroundColor=none;fontFamily=Arial;fontSize=15;fontColor=#526477;" parent="1" edge="1" source="A10" target="IA3"><mxGeometry as="geometry" relative="1"></mxGeometry></mxCell><mxCell id="e41" value="" style="edgeStyle=none;rounded=0;html=0;exitX=0.0;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;strokeColor=#192C42;strokeWidth=1.8;endArrow=block;endFill=0;" parent="1" edge="1" source="ac_cli" target="ac_usu"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="60" y="1034.0" /><mxPoint x="60" y="250" /></Array></mxGeometry></mxCell><mxCell id="e42" value="" style="edgeStyle=none;rounded=0;html=0;exitX=0.0;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0;entryY=0.72;entryDx=0;entryDy=0;entryPerimeter=0;strokeColor=#192C42;strokeWidth=1.8;endArrow=block;endFill=0;" parent="1" edge="1" source="ac_mec" target="ac_usu"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="34" y="1708.0" /><mxPoint x="34" y="266" /></Array></mxGeometry></mxCell><mxCell id="e43" value="" style="edgeStyle=none;rounded=0;html=0;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1.0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;strokeColor=#192C42;strokeWidth=1.8;endArrow=block;endFill=0;" parent="1" edge="1" source="ac_adm" target="ac_usu"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="2700" y="1210.0" /><mxPoint x="2700" y="250" /></Array></mxGeometry></mxCell><mxCell id="nb" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#6C8297;strokeWidth=1.6;" parent="1" vertex="1"><mxGeometry as="geometry" x="250" y="2200" width="1290" height="640" /></mxCell><mxCell id="t44" value="Reglas que fija la sistematización final" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Arial;fontSize=19;fontColor=#192C42;fontStyle=1;spacing=0;" parent="1" vertex="1"><mxGeometry as="geometry" x="270" y="2214" width="1250" height="30" /></mxCell><mxCell id="t45" value="•  «Registrarse como cliente» e «Iniciar sesión» son accesibles sin sesión previa. El resto de las operaciones&#10;exige autenticación y autorización por rol y recurso; cerrar sesión requiere una sesión activa (§8)." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Arial;fontSize=16;fontColor=#192C42;fontStyle=0;spacing=0;" parent="1" vertex="1"><mxGeometry as="geometry" x="270" y="2256" width="1250" height="54" /></mxCell><mxCell id="t46" value="•  El administrador confirma el ingreso físico y crea la orden; el cliente no crea órdenes de trabajo&#10;(§4.1)." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Arial;fontSize=16;fontColor=#192C42;fontStyle=0;spacing=0;" parent="1" vertex="1"><mxGeometry as="geometry" x="270" y="2320" width="1250" height="54" /></mxCell><mxCell id="t47" value="•  El mecánico solo trabaja en órdenes asignadas y no se autoasigna (§4.1)." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Arial;fontSize=16;fontColor=#192C42;fontStyle=0;spacing=0;" parent="1" vertex="1"><mxGeometry as="geometry" x="270" y="2384" width="1250" height="31" /></mxCell><mxCell id="t48" value="•  Solo el cliente propietario aprueba o rechaza una versión; todo rechazo exige un motivo no vacío (§4.3)." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Arial;fontSize=16;fontColor=#192C42;fontStyle=0;spacing=0;" parent="1" vertex="1"><mxGeometry as="geometry" x="270" y="2425" width="1250" height="31" /></mxCell><mxCell id="t49" value="•  Antes de la primera aprobación, rechazar el presupuesto equivale a rechazar el servicio: se confirma con&#10;el cliente y la orden se cancela automáticamente, sin una segunda confirmación administrativa (§4.3)." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Arial;fontSize=16;fontColor=#192C42;fontStyle=0;spacing=0;" parent="1" vertex="1"><mxGeometry as="geometry" x="270" y="2466" width="1250" height="54" /></mxCell><mxCell id="t50" value="•  La confirmación del administrador aplica a la solicitud de cancelación, no al rechazo del presupuesto&#10;(§4.8)." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Arial;fontSize=16;fontColor=#192C42;fontStyle=0;spacing=0;" parent="1" vertex="1"><mxGeometry as="geometry" x="270" y="2530" width="1250" height="54" /></mxCell><mxCell id="t51" value="•  Tras una cancelación, la solicitud de nueva atención requiere revisión administrativa y no crea la orden&#10;automáticamente (§4.9)." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Arial;fontSize=16;fontColor=#192C42;fontStyle=0;spacing=0;" parent="1" vertex="1"><mxGeometry as="geometry" x="270" y="2594" width="1250" height="54" /></mxCell><mxCell id="t52" value="•  Registrar la devolución de un vehículo con orden cancelada no equivale a Entregado (§4.8)." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Arial;fontSize=16;fontColor=#192C42;fontStyle=0;spacing=0;" parent="1" vertex="1"><mxGeometry as="geometry" x="270" y="2658" width="1250" height="31" /></mxCell><mxCell id="t53" value="•  Las tres validaciones de capacidad ocurren en momentos distintos: al configurar los límites, al&#10;registrar el ingreso y al asignar o reasignar (§4.7)." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Arial;fontSize=16;fontColor=#192C42;fontStyle=0;spacing=0;" parent="1" vertex="1"><mxGeometry as="geometry" x="270" y="2699" width="1250" height="54" /></mxCell><mxCell id="t53b" value="•  Rechazar modificaciones posteriores a la primera aprobación no revierte el trabajo: permanece vigente la última&#10;versión aprobada y no se ejecutan los adicionales rechazados. La cancelación normal solo se permite antes de la&#10;primera aprobación (§§4.3 y 4.8)." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Arial;fontSize=16;fontColor=#192C42;fontStyle=0;spacing=0;" parent="1" vertex="1"><mxGeometry as="geometry" x="270" y="2757" width="1250" height="70" /></mxCell><mxCell id="leg" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#6C8297;strokeWidth=1.6;" parent="1" vertex="1"><mxGeometry as="geometry" x="1580" y="2200" width="820" height="365" /></mxCell><mxCell id="t54" value="Notación" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Arial;fontSize=19;fontColor=#192C42;fontStyle=1;spacing=0;" parent="1" vertex="1"><mxGeometry as="geometry" x="1600" y="2214" width="780" height="30" /></mxCell><mxCell id="t55" value="•  Asociación actor–caso: línea continua sin flecha; cruza el límite porque los&#10;actores son externos al sistema." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Arial;fontSize=16;fontColor=#192C42;fontStyle=0;spacing=0;" parent="1" vertex="1"><mxGeometry as="geometry" x="1600" y="2256" width="780" height="54" /></mxCell><mxCell id="t56" value="•  «include»: comportamiento obligatorio que el caso base siempre ejecuta." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Arial;fontSize=16;fontColor=#192C42;fontStyle=0;spacing=0;" parent="1" vertex="1"><mxGeometry as="geometry" x="1600" y="2320" width="780" height="31" /></mxCell><mxCell id="t57" value="•  «extend»: comportamiento condicional. «Confirmar rechazo del servicio»&#10;extiende el rechazo solo cuando no existe una aprobación previa (§4.3)." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Arial;fontSize=16;fontColor=#192C42;fontStyle=0;spacing=0;" parent="1" vertex="1"><mxGeometry as="geometry" x="1600" y="2361" width="780" height="54" /></mxCell><mxCell id="t58" value="•  Generalización de actor: triángulo vacío hacia «Usuario». Cliente, Mecánico&#10;y Administrador heredan iniciar sesión y consultar notificaciones." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Arial;fontSize=16;fontColor=#192C42;fontStyle=0;spacing=0;" parent="1" vertex="1"><mxGeometry as="geometry" x="1600" y="2425" width="780" height="54" /></mxCell><mxCell id="t59" value="•  «Cargar evidencias» es un único caso compartido por Mecánico y Administrador&#10;(§4.4)." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Arial;fontSize=16;fontColor=#192C42;fontStyle=0;spacing=0;" parent="1" vertex="1"><mxGeometry as="geometry" x="1600" y="2489" width="780" height="54" /></mxCell><mxCell id="t60" value="Fuente: Sistematización final §§1.1 (roles), 4.1 (ingreso y asignación), 4.3 (presupuesto), 4.4 (evidencias), 4.6 (inventario), 4.7 (capacidad), 4.8 (cancelación y devolución) y 4.9 (nueva atención)." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Arial;fontSize=15;fontColor=#526477;fontStyle=0;spacing=0;" parent="1" vertex="1"><mxGeometry as="geometry" x="250" y="2880" width="2400" height="28" /></mxCell></root></mxGraphModel></diagram></mxfile>