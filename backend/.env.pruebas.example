# AMBIENTE DE PRUEBAS SEPARADO — plantilla de .env.pruebas
#
# No copiar a mano: `python scripts/ambiente_pruebas.py configurar` crea
# .env.pruebas a partir de esta plantilla y reemplaza cada <generar> por un
# secreto aleatorio propio. .env.pruebas no se sube al repositorio.
#
# Todo apunta a recursos exclusivos del ambiente de pruebas (proyecto Compose
# sgtm_pruebas). `ambiente_pruebas.py verificar` rechaza cualquier valor que
# apunte a los puertos del ambiente local existente (5433-5436, 9000-9001,
# 8000-8004, 5173), a bases sin el sufijo _pruebas o a otro bucket.
SGTM_AMBIENTE=pruebas

# Credenciales de los contenedores (las usa docker-compose.pruebas.yml).
PRUEBAS_PG_USUARIO=sgtm_pruebas
PRUEBAS_PG_CLAVE=<generar>
PRUEBAS_MINIO_ROOT_USUARIO=sgtm-pruebas-root
PRUEBAS_MINIO_ROOT_CLAVE=<generar>

# Bases (usuario y clave iguales a PRUEBAS_PG_*; `configurar` las completa).
MS1_DATABASE_URL=postgresql+psycopg://sgtm_pruebas:<PRUEBAS_PG_CLAVE>@127.0.0.1:5443/taller_ms1_pruebas
MS2_DATABASE_URL=postgresql+psycopg://sgtm_pruebas:<PRUEBAS_PG_CLAVE>@127.0.0.1:5444/taller_ms2_pruebas
MS3_DATABASE_URL=postgresql+psycopg://sgtm_pruebas:<PRUEBAS_PG_CLAVE>@127.0.0.1:5445/taller_ms3_pruebas
MS4_DATABASE_URL=postgresql+psycopg://sgtm_pruebas:<PRUEBAS_PG_CLAVE>@127.0.0.1:5446/taller_ms4_pruebas

# JWT propio: los tokens del ambiente existente no sirven aquí ni al revés.
MS1_JWT_SECRET_KEY=<JWT>
MS2_JWT_SECRET_KEY=<JWT>
MS3_JWT_SECRET_KEY=<JWT>
MS4_JWT_SECRET_KEY=<JWT>
MS1_JWT_ALGORITHM=HS256
MS2_JWT_ALGORITHM=HS256
MS3_JWT_ALGORITHM=HS256
MS4_JWT_ALGORITHM=HS256
MS1_JWT_EXPIRE_MINUTES=120

# Eventos MS2 → MS1 (worker de notificaciones activo en este ambiente).
MS1_EVENT_SHARED_SECRET=<EVENTOS>
MS2_EVENT_SHARED_SECRET=<EVENTOS>
MS2_EVENT_WORKER_ENABLED=true
MS2_TIMEZONE=America/Santiago

# Llamadas entre servicios: solo a los procesos de este ambiente.
MS2_MS1_URL=http://127.0.0.1:8101
MS2_MS3_URL=http://127.0.0.1:8103
MS3_MS2_URL=http://127.0.0.1:8102
MS4_MS2_URL=http://127.0.0.1:8102
MS4_MS3_URL=http://127.0.0.1:8103

# Gateway (puerto 8100) y frontend (puerto 5183).
GATEWAY_MS1_URL=http://127.0.0.1:8101
GATEWAY_MS2_URL=http://127.0.0.1:8102
GATEWAY_MS3_URL=http://127.0.0.1:8103
GATEWAY_MS4_URL=http://127.0.0.1:8104
GATEWAY_CORS_ORIGINS=http://localhost:5183,http://127.0.0.1:5183
# Vacío: no autoriza dominios *.vercel.app en este ambiente.
GATEWAY_CORS_ORIGIN_REGEX=

# MinIO del ambiente de pruebas (usuario de MS4 limitado a su bucket).
MS4_S3_ENDPOINT=http://127.0.0.1:9010
MS4_S3_PUBLIC_ENDPOINT=http://127.0.0.1:9010
MS4_S3_ACCESS_KEY=ms4-evidencias-pruebas
MS4_S3_SECRET_KEY=<generar>
MS4_S3_BUCKET=evidencias-pruebas
MS4_S3_REGION=us-east-1
MS4_S3_SECURE=false

MS1_DB_ECHO=false
MS2_DB_ECHO=false
MS3_DB_ECHO=false
MS4_DB_ECHO=false
