# Plantilla del ambiente de despliegue de base de datos (SGTM).
# NO copiar a mano: `python scripts/inicializar_bd.py configurar` genera
# despliegue/.env.despliegue con claves aleatorias (ignorado por Git).
#
# Las claves se generan con secrets.token_urlsafe: solo A-Z a-z 0-9 - _ ,
# así se pueden poner dentro de una URL sin codificar.

# Proyecto Compose propio (no se mezcla con backend/ ni con sgtm_pruebas).
COMPOSE_PROJECT_NAME=sgtm_despliegue

# Superusuario de PostgreSQL: SOLO para crear roles y bases la primera vez.
# Ningún microservicio lo usa.
DESPLIEGUE_PG_ADMIN_USUARIO=sgtm_admin
DESPLIEGUE_PG_ADMIN_CLAVE=__GENERAR__
DESPLIEGUE_PG_PUERTO=5460

# Un rol y una base por microservicio (dueño de su base, sin superusuario).
SGTM_MS1_BD_CLAVE=__GENERAR__
SGTM_MS2_BD_CLAVE=__GENERAR__
SGTM_MS3_BD_CLAVE=__GENERAR__
SGTM_MS4_BD_CLAVE=__GENERAR__

# Marca que queda en cada base. "sgtm-despliegue-demo" permite que
# datos_demo.py cargue/limpie datos de demostración; "sgtm-despliegue" lo impide.
SGTM_BD_MARCA=sgtm-despliegue-demo

# Clave JWT compartida (los servicios la exigen al importar su configuración).
SGTM_JWT_SECRET=__GENERAR__

# Conexiones desde el equipo (scripts del host) hacia el contenedor publicado
# en 127.0.0.1. Dentro de la red Compose se usa el host "postgres".
MS1_DATABASE_URL=postgresql+psycopg://sgtm_ms1:${SGTM_MS1_BD_CLAVE}@127.0.0.1:5460/sgtm_ms1
MS2_DATABASE_URL=postgresql+psycopg://sgtm_ms2:${SGTM_MS2_BD_CLAVE}@127.0.0.1:5460/sgtm_ms2
MS3_DATABASE_URL=postgresql+psycopg://sgtm_ms3:${SGTM_MS3_BD_CLAVE}@127.0.0.1:5460/sgtm_ms3
MS4_DATABASE_URL=postgresql+psycopg://sgtm_ms4:${SGTM_MS4_BD_CLAVE}@127.0.0.1:5460/sgtm_ms4
MS1_JWT_SECRET_KEY=${SGTM_JWT_SECRET}
MS2_JWT_SECRET_KEY=${SGTM_JWT_SECRET}
MS3_JWT_SECRET_KEY=${SGTM_JWT_SECRET}
MS4_JWT_SECRET_KEY=${SGTM_JWT_SECRET}
