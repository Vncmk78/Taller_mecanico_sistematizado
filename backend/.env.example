# Copia este archivo a .env y ajusta los valores. .env NO se sube al repositorio.
# Cuatro bases independientes, una por microservicio (Sistematizacion final 1.2 y 8).
# DESARROLLO LOCAL (PostgreSQL en localhost):
#   postgresql+psycopg://USUARIO:PASSWORD@HOST:PUERTO/NOMBRE_BD
# PRODUCCION (Neon en Vercel): agregar `?sslmode=require` al DSN, p. ej.:
#   postgresql+psycopg://usuario:password@ep-xxxx-yyy.az.northamerica-northeast1.aws.neon.tech/taller_ms1?sslmode=require

MS1_DATABASE_URL=postgresql+psycopg://taller:taller@localhost:5433/taller_ms1
MS2_DATABASE_URL=postgresql+psycopg://taller:taller@localhost:5434/taller_ms2
MS3_DATABASE_URL=postgresql+psycopg://taller:taller@localhost:5435/taller_ms3
MS4_DATABASE_URL=postgresql+psycopg://taller:taller@localhost:5436/taller_ms4

# Autenticacion JWT. Misma clave en MS1 y MS2 (HS256 comparte la firma).
# Generar una clave aleatoria de al menos 32 caracteres con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
MS1_JWT_SECRET_KEY=reemplaza-por-una-clave-aleatoria-de-al-menos-32-caracteres
MS1_JWT_ALGORITHM=HS256
MS1_JWT_EXPIRE_MINUTES=60
MS2_JWT_SECRET_KEY=reemplaza-por-la-misma-clave-configurada-en-ms1
MS2_JWT_ALGORITHM=HS256

# Poner en true solo para depurar: imprime todo el SQL en consola.
MS1_DB_ECHO=false
MS2_DB_ECHO=false
MS3_DB_ECHO=false
MS4_DB_ECHO=false

# ---------------------------------------------------------------------------
# API GATEWAY (solo aplica si levantas gateway/)
# ---------------------------------------------------------------------------
# En Vercel estos valores se inyectan automaticamente como bindings de servicio
# (GATEWAY_MS1_URL ... GATEWAY_MS4_URL); en desarrollo local se usan los
# localhost de abajo. CORS_ORIGINS: lista separada por comas de origenes
# permitidos; los *.vercel.app ya se autorizan por regex en el codigo.
GATEWAY_MS1_URL=http://localhost:8001
GATEWAY_MS2_URL=http://localhost:8002
GATEWAY_MS3_URL=http://localhost:8003
GATEWAY_MS4_URL=http://localhost:8004
GATEWAY_CORS_ORIGINS=http://localhost:5173,http://localhost:8000
GATEWAY_CORS_ALLOW_CREDENTIALS=true

# MinIO (almacenamiento de objetos S3-compatible para MS4)
# En desarrollo corre en Docker (docker compose up -d minio minio_init).
# El root solo se usa para administrar MinIO; MS4 opera con el usuario ms4-evidencias.
MINIO_ROOT_USER=admin-local
MINIO_ROOT_PASSWORD=cambia-esta-clave-local

# Configuración S3 que usa MS4. El usuario debe existir en MinIO con permisos
# solo sobre el bucket 'evidencias' (ver minio/politica-ms4.json).
MS4_S3_ENDPOINT=http://localhost:9000
MS4_S3_ACCESS_KEY=ms4-evidencias
MS4_S3_SECRET_KEY=cambia-esta-clave-ms4
MS4_S3_BUCKET=evidencias
MS4_S3_REGION=us-east-1
MS4_S3_SECURE=false
