ize=15;fontColor=#526477;" parent="1" edge="1" source="p3" target="inot"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="1216.8" y="768" /><mxPoint x="355.52" y="768" /></Array></mxGeometry></mxCell><mxCell id="e91" value="" style="edgeStyle=none;rounded=0;html=0;exitX=0.06;exitY=0.0;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.12;entryY=1.0;entryDx=0;entryDy=0;entryPerimeter=0;strokeColor=#6C8297;strokeWidth=1.7;endArrow=open;endFill=0;dashed=1;dashPattern=6 4;verticalAlign=bottom;labelBackgroundColor=none;fontFamily=Arial;fontSize=15;fontColor=#526477;" parent="1" edge="1" source="p4" target="inot"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="1707.6" y="790" /><mxPoint x="318.08" y="790" /></Array></mxGeometry></mxCell><mxCell id="e92" value="" style="edgeStyle=none;rounded=0;html=0;exitX=0.1;exitY=0.0;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.8;entryY=1.0;entryDx=0;entryDy=0;entryPerimeter=0;strokeColor=#6C8297;strokeWidth=1.7;endArrow=open;endFill=0;dashed=1;dashPattern=6 4;" parent="1" edge="1" source="p2" target="iusr"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="726" y="690" /><mxPoint x="220" y="690" /></Array></mxGeometry></mxCell><mxCell id="tbl" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#6C8297;strokeWidth=1.6;" parent="1" vertex="1"><mxGeometry as="geometry" x="60" y="1420" width="1220" height="268" /></mxCell><mxCell id="t92" value="Dependencias entre servicios (por contrato de API, sin consultas SQL cruzadas)" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Arial;fontSize=19;fontColor=#192C42;fontStyle=1;spacing=0;" parent="1" vertex="1"><mxGeometry as="geometry" x="78" y="1432" width="1180" height="28" /></mxCell><mxCell id="t93" value="Operación del taller  →  IPresupuestos" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Arial;fontSize=17;fontColor=#192C42;fontStyle=1;spacing=0;" parent="1" vertex="1"><mxGeometry as="geometry" x="80" y="1472" width="1180" height="26" /></mxCell><mxCell id="t94" value="Consulta el presupuesto aprobado y la disponibilidad de repuestos antes de continuar." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Arial;fontSize=15;fontColor=#526477;fontStyle=0;spacing=0;" parent="1" vertex="1"><mxGeometry as="geometry" x="80" y="1498" width="1180" height="24" /></mxCell><mxCell id="t95" value="Presupuesto e inventario  →  IOrdenes" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Arial;fontSize=17;fontColor=#192C42;fontStyle=1;spacing=0;" parent="1" vertex="1"><mxGeometry as="geometry" x="80" y="1526" width="1180" height="26" /></mxCell><mxCell id="t96" value="Valida la orden y su propietario; comunica envío, decisión y disponibilidad." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Arial;fontSize=15;fontColor=#526477;fontStyle=0;spacing=0;" parent="1" vertex="1"><mxGeometry as="geometry" x="80" y="1552" width="1180" height="24" /></mxCell><mxCell id="t97" value="Gestión de evidencias  →  IOrdenes" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Arial;fontSize=17;fontColor=#192C42;fontStyle=1;spacing=0;" parent="1" vertex="1"><mxGeometry as="geometry" x="80" y="1580" width="1180" height="26" /></mxCell><mxCell id="t98" value="Comprueba el vínculo con la orden y el acceso del usuario." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Arial;fontSize=15;fontColor=#526477;fontStyle=0;spacing=0;" parent="1" vertex="1"><mxGeometry as="geometry" x="80" y="1606" width="1180" height="24" /></mxCell><mxCell id="t99" value="MS2, MS3 y MS4  →  INotificaciones" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Arial;fontSize=17;fontColor=#192C42;fontStyle=1;spacing=0;" parent="1" vertex="1"><mxGeometry as="geometry" x="80" y="1634" width="1180" height="26" /></mxCell><mxCell id="t100" value="Solicitan a MS1 los avisos de sus dominios; MS3 además solicita las alertas de stock." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Arial;fontSize=15;fontColor=#526477;fontStyle=0;spacing=0;" parent="1" vertex="1"><mxGeometry as="geometry" x="80" y="1660" width="1180" height="24" /></mxCell><mxCell id="leg" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#6C8297;strokeWidth=1.6;" parent="1" vertex="1"><mxGeometry as="geometry" x="1340" y="1420" width="800" height="324" /></mxCell><mxCell id="t101" value="Notación" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Arial;fontSize=19;fontColor=#192C42;fontStyle=1;spacing=0;" parent="1" vertex="1"><mxGeometry as="geometry" x="1360" y="1434" width="760" height="30" /></mxCell><mxCell id="t102" value="•  Flecha discontinua con punta abierta: dependencia (requiere una interfaz)." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Arial;fontSize=16;fontColor=#192C42;fontStyle=0;spacing=0;" parent="1" vertex="1"><mxGeometry as="geometry" x="1360" y="1476" width="760" height="31" /></mxCell><mxCell id="t103" value="•  Flecha discontinua con triángulo vacío: realización. El microservicio&#10;publica la interfaz; internamente la implementa su componente «API REST +&#10;autorización»." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Arial;fontSize=16;fontColor=#192C42;fontStyle=0;spacing=0;" parent="1" vertex="1"><mxGeometry as="geometry" x="1360" y="1517" width="760" height="77" /></mxCell><mxCell id="t104" value="•  Cada persistencia accede únicamente a la base de su propio microservicio;&#10;MS4 además usa el almacenamiento de objetos." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Arial;fontSize=16;fontColor=#192C42;fontStyle=0;spacing=0;" parent="1" vertex="1"><mxGeometry as="geometry" x="1360" y="1604" width="760" height="54" /></mxCell><mxCell id="t105" value="•  La separación API / dominio / persistencia es una propuesta de diseño&#10;interno, no un requisito nuevo." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Arial;fontSize=16;fontColor=#192C42;fontStyle=0;spacing=0;" parent="1" vertex="1"><mxGeometry as="geometry" x="1360" y="1668" width="760" height="54" /></mxCell><mxCell id="t101" value="MS2  →  IUsuarios" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Arial;fontSize=17;fontColor=#192C42;fontStyle=1;spacing=0;" parent="1" vertex="1"><mxGeometry as="geometry" x="1300" y="1634" width="980" height="26" /></mxCell><mxCell id="t101b" value="Consulta por API el nombre y el correo oficiales almacenados en MS1; no los duplica (§4.1)." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Arial;fontSize=15;fontColor=#526477;fontStyle=0;spacing=0;" parent="1" vertex="1"><mxGeometry as="geometry" x="1300" y="1660" width="980" height="24" /></mxCell><mxCell id="t106" value="Fuente: Sistematización final §1.2 (Gateway como punto único y cuatro servicios), §4.5 (MS1 aloja las notificaciones y los demás las solicitan por API) y §8 (aislamiento de datos)." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Arial;fontSize=15;fontColor=#526477;fontStyle=0;spacing=0;" parent="1" vertex="1"><mxGeometry as="geometry" x="60" y="1712" width="2200" height="28" /></mxCell></root></mxGraphModel></diagram></mxfile>